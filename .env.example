# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/signal
DATABASE_URL_SYNC=postgresql+psycopg://postgres:postgres@db:5432/signal

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── OpenAI ────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_LLM_MODEL=gpt-4o-mini

# ── World News API ────────────────────────────────────────────────────
WORLDNEWS_API_KEY=your-key

# ── Telegram (optional) ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Shared secret returned by Telegram in the X-Telegram-Bot-Api-Secret-Token
# header on every webhook delivery (PR #45). REQUIRED in production if
# TELEGRAM_BOT_TOKEN is set — empty disables the auth check (dev only).
# Pass the same value to setWebhook so Telegram echoes it back. Generate
# with `openssl rand -hex 32`.
TELEGRAM_WEBHOOK_SECRET=

# ── Environment ───────────────────────────────────────────────────────
ENV=development

# ── Ingestion intervals (seconds) ────────────────────────────────────
RSS_POLL_INTERVAL_SECONDS=45
X_POLL_INTERVAL_SECONDS=60
WORLDNEWS_POLL_INTERVAL_SECONDS=120
MARKET_REFRESH_INTERVAL_SECONDS=300

# ── Signal thresholds ────────────────────────────────────────────────
SIGNAL_SCORE_THRESHOLD=65
HARD_EXCLUSION_SPREAD=0.15
HARD_EXCLUSION_AMBIGUITY=0.80
# Emit BUY_YES/BUY_NO only if YES implied probability is inside this band (0–1 scale)
SIGNAL_TRADEABLE_YES_MIN=0.08
SIGNAL_TRADEABLE_YES_MAX=0.92

# Articles older than this are dropped at ingestion (PR #?). 2.0 hours
# matches what `tier1_rss_poll_interval_seconds=15` can keep up with.
RSS_MAX_ARTICLE_AGE_HOURS=2.0
# Events whose newest article is older than this are rejected at scoring
# time. Aligned with RSS_MAX_ARTICLE_AGE_HOURS for end-to-end freshness.
SIGNAL_EVENT_MAX_AGE_HOURS=2.0

# ── Signal de-duplication (PR #63 — two-layer) ───────────────────────
# Layer 1: exact dedupe key window. Same `bucket | market_id | event_title`
# hash within this many hours blocks the second emission.
SIGNAL_DEDUPE_WINDOW_HOURS=72.0
# Layer 2: thematic dedupe via cosine on `markets.embedding`. Catches
# the "May 31 vs June 30 twin-market" case (audit 2026-05-05).
THEMATIC_DEDUP_WINDOW_HOURS=12.0
# Threshold ≥ this on cosine similarity = duplicate. Measured ~0.93 on
# the live Hormuz blockade pair. Don't drop below 0.75 (false positives).
THEMATIC_DEDUP_COSINE_THRESHOLD=0.85

# ── LLM cost guardrail ──────────────────────────────────────────────
LLM_COST_ALERT_USD=30.0

# ── Ingestion health ─────────────────────────────────────────────────
TIER1_LAG_ALERT_SECONDS=180

# ── Retrieval ─────────────────────────────────────────────────────────
TOP_K_MARKETS=10
RRF_K=60

# ── Clustering ────────────────────────────────────────────────────────
CLUSTERING_COSINE_THRESHOLD=0.82
CLUSTERING_TIME_WINDOW_MINUTES=60
CLUSTERING_SIMHASH_THRESHOLD=0.15

# ── Polymarket Builder API (trade execution) ─────────────────────────
BUILDER_API_KEY=
BUILDER_API_SECRET=
BUILDER_API_PASSPHRASE=
BUILDER_PRIVATE_KEY=
POLYGON_CHAIN_ID=137

# ── Stripe (payments) ────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TRADER=

# ── Auth ────────────────────────────────────────────────────────────
# DEV DEFAULT — production boot fails on this value (PR #54).
# Generate with `openssl rand -hex 32` for any non-local environment.
JWT_SECRET_KEY=change-me-in-production
# Google Sign-In — OAuth 2.0 Web client ID (must match frontend VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=

# ── CORS (PR #45 — production hardening) ─────────────────────────────
# Comma-separated allow-list. Wildcard `*` is REJECTED in production.
# Defaults to a built-in list including localhost in dev.
# CORS_ORIGINS=https://getforesight.io,https://www.getforesight.io

# Frontend (Vite): create frontend/.env.local with the same client ID for the Google button:
# VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Base URL for the API (optional; defaults to the Vite proxy "/api" in dev,
# "/api" in prod through nginx). Set to an absolute URL for standalone hosting:
# VITE_API_URL=https://api.getforesight.io/api

# ── Stripe mode (dev vs live) ────────────────────────────────────────
# "test" uses STRIPE_SECRET_KEY in test mode; "live" enables real charges.
STRIPE_MODE=test

# ── Application ─────────────────────────────────────────────────────
APP_BASE_URL=https://getforesight.io

# ── Push Notifications (VAPID) ───────────────────────────────────────
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_EMAIL=hello@getforesight.io

# ── Operational opt-ins (PR #42, #43) ────────────────────────────────
# Worker recycle threshold — Celery `--pool=solo` doesn't honor
# worker_max_tasks_per_child (prefork-only), so we count completed
# tasks and `os._exit(0)` after this many. 100 ≈ 30-50 min between
# recycles in our throughput band. Set to 0 to disable (NOT recommended).
# CELERY_WORKER_MAX_TASKS=100

# SQLAlchemy SQL trace. LEAVE UNSET in production — `echo=True` blew
# the log buffer past the 3 GB cgroup limit and was the OOM trigger of
# the 6-day outage (PR #43). Enable only for local SQL debugging.
# DB_ECHO=

# ── X / Twitter via RSSHub (cookies from a burner X account) ─────────
# See docs/setup-rsshub-twitter.md for how to extract them. Empty values
# disable the X-via-RSSHub source.
TWITTER_AUTH_TOKEN=
TWITTER_CT0=

# ── Production deploy ────────────────────────────────────────────────
# For a real production cutover, copy `scripts/deploy/production.env.template`
# instead of this file — it's commented per-line with what fails if
# missing, and `bash scripts/deploy/preflight-check.sh` validates it
# before `docker compose up`.
