# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/signal
DATABASE_URL_SYNC=postgresql://postgres:postgres@db:5432/signal

# Redis
REDIS_URL=redis://redis:6379/0

# OpenAI
OPENAI_API_KEY=sk-your-openai-key-here

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# World News API
WORLDNEWS_API_KEY=your-worldnews-api-key

# Environment
ENV=development

# Signal Configuration
SIGNAL_SCORE_THRESHOLD=60
LLM_COST_ALERT_EUR=30.0
TIER1_LAG_ALERT_SECONDS=180

# Retrieval
TOP_K_MARKETS=10

# Clustering
CLUSTERING_COSINE_THRESHOLD=0.82
CLUSTERING_TIME_WINDOW_MINUTES=60