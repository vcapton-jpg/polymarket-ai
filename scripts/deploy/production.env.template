# Production environment template — Foresight
#
# Copy this file to `.env` at the repo root, then fill in every value
# marked REQUIRED.
#
#   $ cp scripts/deploy/production.env.template .env
#   $ nano .env
#   $ bash scripts/deploy/preflight-check.sh
#
# The pre-flight check refuses to let you boot in production with any
# default still in place. Run it before `docker compose up`.
#
# Generators (have these handy in your password manager):
#   $ openssl rand -hex 32   # JWT_SECRET_KEY, TELEGRAM_WEBHOOK_SECRET
#   $ openssl rand -hex 24   # POSTGRES_PASSWORD
#   $ openssl rand -base64 24

# ─────────────────────────────────────────────────────────────────────
# REQUIRED — environment selector
# ─────────────────────────────────────────────────────────────────────
# Setting this to `production` activates the JWT default-secret gate
# (PR #54), the strict CORS allow-list, and disables the dev-only
# escape hatches in `_assert_jwt_secret_safe_for_env`.
ENV=production

# ─────────────────────────────────────────────────────────────────────
# REQUIRED — database
# ─────────────────────────────────────────────────────────────────────
# Change `postgres:postgres` to `postgres:<your-strong-password>`.
# The pre-flight check refuses to boot if the password is `postgres`,
# `password`, `admin`, or empty.
#
# Both URLs MUST point to the same DB; the async one is for SQLAlchemy
# 2.0, the sync one is for Alembic migrations + pgvector tooling.
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME_STRONG@db:5432/signal
DATABASE_URL_SYNC=postgresql+psycopg://postgres:CHANGE_ME_STRONG@db:5432/signal

# Postgres container init password — must match the one in DATABASE_URL.
POSTGRES_PASSWORD=CHANGE_ME_STRONG

# ─────────────────────────────────────────────────────────────────────
# REQUIRED — Redis (default URL is fine; no auth in single-host VPS)
# ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─────────────────────────────────────────────────────────────────────
# REQUIRED — JWT auth secret
# ─────────────────────────────────────────────────────────────────────
# Generate with `openssl rand -hex 32`. The pre-flight check rejects
# any value that matches the public defaults shipped in dev.
JWT_SECRET_KEY=GENERATE_WITH_openssl_rand_hex_32

# ─────────────────────────────────────────────────────────────────────
# REQUIRED — OpenAI (rotated 2026-05-05)
# ─────────────────────────────────────────────────────────────────────
# The key from `.env.backup-2026-04-27` is considered exposed. Generate
# a fresh one at https://platform.openai.com/api-keys.
OPENAI_API_KEY=sk-proj-...

# Models — gpt-4o-mini is the default (PR #35, cost reduction). Don't
# change to gpt-4o without thinking about the LLM cost circuit
# breaker.
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# 24 h rolling LLM budget. The breaker trips and refuses new chat
# completions once spend crosses this threshold. 50 USD is a sane prod
# default; tune to your appetite.
LLM_COST_ALERT_USD=50.0

# ─────────────────────────────────────────────────────────────────────
# REQUIRED — WorldNews API (rotated 2026-05-05)
# ─────────────────────────────────────────────────────────────────────
WORLDNEWS_API_KEY=...

# ─────────────────────────────────────────────────────────────────────
# REQUIRED if Telegram bot is wired — webhook auth secret
# ─────────────────────────────────────────────────────────────────────
# Bot token from @BotFather. Empty disables the Telegram routes.
TELEGRAM_BOT_TOKEN=

# Optional admin chat ID (alerts go here in addition to user-specific
# chat IDs). Leave empty if not used.
TELEGRAM_CHAT_ID=

# REQUIRED if `TELEGRAM_BOT_TOKEN` is set in production. Generate with
# `openssl rand -hex 32`. Also pass this same value to `setWebhook`
# (see runbook step 7). Empty disables auth — dev only.
TELEGRAM_WEBHOOK_SECRET=GENERATE_WITH_openssl_rand_hex_32

# ─────────────────────────────────────────────────────────────────────
# REQUIRED if Twitter ingestion is wired (RSSHub burner cookies)
# ─────────────────────────────────────────────────────────────────────
# Both rotated 2026-05-05. Empty disables the X-via-RSSHub source.
# Setup runbook: docs/setup-rsshub-twitter.md
TWITTER_AUTH_TOKEN=
TWITTER_CT0=

# ─────────────────────────────────────────────────────────────────────
# OPTIONAL — Google Sign-In (OAuth Web client ID)
# ─────────────────────────────────────────────────────────────────────
# Same value used by VITE_GOOGLE_CLIENT_ID on frontend.
GOOGLE_CLIENT_ID=

# ─────────────────────────────────────────────────────────────────────
# REQUIRED — frontend / CORS allow-list
# ─────────────────────────────────────────────────────────────────────
# The base URL the frontend uses to reach the API. In production this
# is your domain.
APP_BASE_URL=https://foresight.example.com

# Allowed CORS origins — comma-separated. Restrict to the public
# frontend domain. The dev wildcard from the README is a security hole
# in prod.
CORS_ORIGINS=https://foresight.example.com

# ─────────────────────────────────────────────────────────────────────
# OPTIONAL — pipeline tuning (defaults are reasonable for prod)
# ─────────────────────────────────────────────────────────────────────
SIGNAL_SCORE_THRESHOLD=65
TOP_K_MARKETS=10
CLUSTERING_COSINE_THRESHOLD=0.75
CLUSTERING_TIME_WINDOW_MINUTES=90
RSS_MAX_ARTICLE_AGE_HOURS=2.0
SIGNAL_EVENT_MAX_AGE_HOURS=2.0

# Worker recycle threshold (PR #42). 100 = ~30-50 min between recycles
# at our throughput. Set to 0 to disable (NOT recommended).
CELERY_WORKER_MAX_TASKS=100

# DB echo opt-in (PR #43). LEAVE UNSET in production — `echo=True` was
# the OOM trigger of the 6-day outage. Only enable for local SQL trace.
# DB_ECHO=

# Optional Sentry DSN for backend exception capture
# SENTRY_DSN=
