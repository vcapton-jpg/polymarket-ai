# Environment — never commit any .env variant or backup
.env
.env.local
.env.production
.env.*.local
.env.backup*
.env.bak*
.env.*.backup

# Generic dated/local backup files — past leaks were dated copies of
# .env / docker-compose.yml left in repo root. Block by pattern.
*.backup-*
*.bak
*.bak.*

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Node
node_modules/
frontend/dist/
frontend/.vite/
frontend/*.tsbuildinfo
frontend/vite.config.js
frontend/vite.config.d.ts

# Playwright MCP runtime
.playwright-mcp/
.cursor/

# Claude Code session metadata + worktrees
.claude/

# Docker
*.log

# Test / Coverage
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/